<?xml version="1.0" encoding="UTF-8"?>
<composite name="LoanDBComposite"
           revision="1.0"
           label="Loan Database Adapter Pattern Demo"
           mode="active"
           state="on"
           xmlns="http://xmlns.oracle.com/sca/1.0"
           xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:wsp="http://schemas.xmlsoap.org/ws/2004/09/policy"
           xmlns:orawsp="http://schemas.oracle.com/ws/2006/01/policy"
           xmlns:ui="http://xmlns.oracle.com/soa/designer/">

    <!-- ================================================================== -->
    <!-- SOA Database Adapter Pattern - Complete Call Chain Demo            -->
    <!--                                                                    -->
    <!-- Call Chain:                                                        -->
    <!-- Java Client (SOAP) → WSDL → SOA_SERVICE → SOA_COMPONENT → BPEL    -->
    <!--   → SOA_REFERENCE → JCA_ADAPTER_DB → DatabaseEntity               -->
    <!-- ================================================================== -->

    <!-- Import WSDLs -->
    <import namespace="http://xmlns.oracle.com/LendWise/LoanDBProcess"
            location="LoanDBProcess.wsdl"
            importType="wsdl"/>

    <!-- Import DB Adapter WSDLs -->
    <import namespace="http://xmlns.oracle.com/LendWise/adapter/db/LoanDB"
            location="adapters/LoanDB.wsdl"
            importType="wsdl"/>
    <import namespace="http://xmlns.oracle.com/LendWise/adapter/db/BorrowerDB"
            location="adapters/BorrowerDB.wsdl"
            importType="wsdl"/>
    <import namespace="http://xmlns.oracle.com/LendWise/adapter/db/DecisionDB"
            location="adapters/DecisionDB.wsdl"
            importType="wsdl"/>

    <!-- ================================================================== -->
    <!-- Exposed Services (Entry Points)                                    -->
    <!-- ================================================================== -->

    <!-- SOAP Service Entry Point -->
    <service name="LoanDBService" ui:wsdlLocation="LoanDBProcess.wsdl">
        <interface.wsdl interface="http://xmlns.oracle.com/LendWise/LoanDBProcess#wsdl.interface(LoanDBProcess)"/>
        <binding.ws port="http://xmlns.oracle.com/LendWise/LoanDBProcess#wsdl.endpoint(loandb_client_ep/LoanDBProcess_pt)">
            <property name="weblogic.wsee.wsat.transaction.flowOption" type="xs:string" many="false">NEVER</property>
        </binding.ws>
    </service>

    <!-- ================================================================== -->
    <!-- BPEL Component                                                     -->
    <!-- ================================================================== -->

    <component name="LoanDBProcess" version="2.0">
        <implementation.bpel src="LoanDBProcess.bpel"/>
        <componentType>
            <!-- Inbound Service Interface -->
            <service name="LoanDBService" ui:wsdlLocation="LoanDBProcess.wsdl">
                <interface.wsdl interface="http://xmlns.oracle.com/LendWise/LoanDBProcess#wsdl.interface(LoanDBProcess)"/>
            </service>

            <!-- Database Adapter References -->
            <reference name="LoanDBAdapter" ui:wsdlLocation="adapters/LoanDB.wsdl">
                <interface.wsdl interface="http://xmlns.oracle.com/LendWise/adapter/db/LoanDB#wsdl.interface(LoanDB_ptt)"/>
            </reference>
            <reference name="BorrowerDBAdapter" ui:wsdlLocation="adapters/BorrowerDB.wsdl">
                <interface.wsdl interface="http://xmlns.oracle.com/LendWise/adapter/db/BorrowerDB#wsdl.interface(BorrowerDB_ptt)"/>
            </reference>
            <reference name="DecisionDBAdapter" ui:wsdlLocation="adapters/DecisionDB.wsdl">
                <interface.wsdl interface="http://xmlns.oracle.com/LendWise/adapter/db/DecisionDB#wsdl.interface(DecisionDB_ptt)"/>
            </reference>
        </componentType>
        <property name="bpel.config.transaction" type="xs:string" many="false">required</property>
    </component>

    <!-- ================================================================== -->
    <!-- Database Adapter References (binding.jca)                          -->
    <!-- ================================================================== -->

    <!-- Loan Application Database Adapter -->
    <reference name="LoanDBAdapter" ui:wsdlLocation="adapters/LoanDB.wsdl">
        <interface.wsdl interface="http://xmlns.oracle.com/LendWise/adapter/db/LoanDB#wsdl.interface(LoanDB_ptt)"/>
        <binding.jca config="adapters/LoanDB.jca"/>
    </reference>

    <!-- Borrower Database Adapter -->
    <reference name="BorrowerDBAdapter" ui:wsdlLocation="adapters/BorrowerDB.wsdl">
        <interface.wsdl interface="http://xmlns.oracle.com/LendWise/adapter/db/BorrowerDB#wsdl.interface(BorrowerDB_ptt)"/>
        <binding.jca config="adapters/BorrowerDB.jca"/>
    </reference>

    <!-- Decision Database Adapter -->
    <reference name="DecisionDBAdapter" ui:wsdlLocation="adapters/DecisionDB.wsdl">
        <interface.wsdl interface="http://xmlns.oracle.com/LendWise/adapter/db/DecisionDB#wsdl.interface(DecisionDB_ptt)"/>
        <binding.jca config="adapters/DecisionDB.jca"/>
    </reference>

    <!-- ================================================================== -->
    <!-- Wiring                                                             -->
    <!-- ================================================================== -->

    <!-- Service Entry → BPEL Component -->
    <wire>
        <source.uri>LoanDBService</source.uri>
        <target.uri>LoanDBProcess/LoanDBService</target.uri>
    </wire>

    <!-- BPEL Component → Database Adapters -->
    <wire>
        <source.uri>LoanDBProcess/LoanDBAdapter</source.uri>
        <target.uri>LoanDBAdapter</target.uri>
    </wire>
    <wire>
        <source.uri>LoanDBProcess/BorrowerDBAdapter</source.uri>
        <target.uri>BorrowerDBAdapter</target.uri>
    </wire>
    <wire>
        <source.uri>LoanDBProcess/DecisionDBAdapter</source.uri>
        <target.uri>DecisionDBAdapter</target.uri>
    </wire>

</composite>
