<?xml version="1.0" encoding="UTF-8"?>
<wsdl:definitions name="BorrowerDB"
                  targetNamespace="http://xmlns.oracle.com/LendWise/adapter/db/BorrowerDB"
                  xmlns:tns="http://xmlns.oracle.com/LendWise/adapter/db/BorrowerDB"
                  xmlns:types="http://xmlns.oracle.com/LendWise/LoanDBProcess/types"
                  xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
                  xmlns:jca="http://xmlns.oracle.com/pcbpel/wsdl/jca/"
                  xmlns:plnk="http://docs.oasis-open.org/wsbpel/2.0/plnktype">

    <!-- Import XSD Types -->
    <wsdl:types>
        <xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema">
            <xsd:import namespace="http://xmlns.oracle.com/LendWise/LoanDBProcess/types"
                        schemaLocation="../LoanDBTypes.xsd"/>
        </xsd:schema>
    </wsdl:types>

    <!-- Messages for DB Operations -->
    <wsdl:message name="BorrowerCollectionMessage">
        <wsdl:part name="BorrowerCollection" element="types:BorrowerCollection"/>
    </wsdl:message>
    <wsdl:message name="BorrowerSelectBySSNMessage">
        <wsdl:part name="ssn" type="xsd:string" xmlns:xsd="http://www.w3.org/2001/XMLSchema"/>
    </wsdl:message>

    <!-- PortType - Database Adapter Operations -->
    <wsdl:portType name="BorrowerDB_ptt">
        <wsdl:operation name="insertBorrower">
            <wsdl:documentation>
                Insert new borrower record.
                JCA: oracle.tip.adapter.db.DBWriteInteractionSpec
                DmlType: INSERT
                DescriptorName: BorrowerDB.Borrower
            </wsdl:documentation>
            <wsdl:input message="tns:BorrowerCollectionMessage"/>
        </wsdl:operation>

        <wsdl:operation name="selectBorrowerBySSN">
            <wsdl:documentation>
                Select borrower by SSN.
                JCA: oracle.tip.adapter.db.DBReadInteractionSpec
                QueryObjectName: selectBySSN
                DescriptorName: BorrowerDB.Borrower
            </wsdl:documentation>
            <wsdl:input message="tns:BorrowerSelectBySSNMessage"/>
            <wsdl:output message="tns:BorrowerCollectionMessage"/>
        </wsdl:operation>

        <wsdl:operation name="updateBorrowerCredit">
            <wsdl:documentation>
                Update borrower credit score.
                JCA: oracle.tip.adapter.db.DBWriteInteractionSpec
                DmlType: UPDATE
                DescriptorName: BorrowerDB.Borrower
            </wsdl:documentation>
            <wsdl:input message="tns:BorrowerCollectionMessage"/>
        </wsdl:operation>
    </wsdl:portType>

    <!-- JCA Binding -->
    <wsdl:binding name="BorrowerDB_binding" type="tns:BorrowerDB_ptt">
        <jca:binding/>
        <wsdl:operation name="insertBorrower">
            <jca:operation/>
            <wsdl:input/>
        </wsdl:operation>
        <wsdl:operation name="selectBorrowerBySSN">
            <jca:operation/>
            <wsdl:input/>
            <wsdl:output/>
        </wsdl:operation>
        <wsdl:operation name="updateBorrowerCredit">
            <jca:operation/>
            <wsdl:input/>
        </wsdl:operation>
    </wsdl:binding>

    <!-- Service -->
    <wsdl:service name="BorrowerDB_service">
        <wsdl:port name="BorrowerDB_pt" binding="tns:BorrowerDB_binding">
            <jca:address location="eis/DB/LendWiseDS"/>
        </wsdl:port>
    </wsdl:service>

    <!-- Partner Link Type -->
    <plnk:partnerLinkType name="BorrowerDB_plt">
        <plnk:role name="BorrowerDBProvider" portType="tns:BorrowerDB_ptt"/>
    </plnk:partnerLinkType>

</wsdl:definitions>
