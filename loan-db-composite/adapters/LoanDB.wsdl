<?xml version="1.0" encoding="UTF-8"?>
<wsdl:definitions name="LoanDB"
                  targetNamespace="http://xmlns.oracle.com/LendWise/adapter/db/LoanDB"
                  xmlns:tns="http://xmlns.oracle.com/LendWise/adapter/db/LoanDB"
                  xmlns:types="http://xmlns.oracle.com/LendWise/LoanDBProcess/types"
                  xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
                  xmlns:jca="http://xmlns.oracle.com/pcbpel/wsdl/jca/"
                  xmlns:plnk="http://docs.oasis-open.org/wsbpel/2.0/plnktype">

    <!-- Import XSD Types -->
    <wsdl:types>
        <xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema">
            <xsd:import namespace="http://xmlns.oracle.com/LendWise/LoanDBProcess/types"
                        schemaLocation="../LoanDBTypes.xsd"/>
        </xsd:schema>
    </wsdl:types>

    <!-- Messages for DB Operations -->
    <wsdl:message name="LoanApplicationCollectionMessage">
        <wsdl:part name="LoanApplicationCollection" element="types:LoanApplicationCollection"/>
    </wsdl:message>
    <wsdl:message name="LoanSelectByIdMessage">
        <wsdl:part name="loanId" type="xsd:string" xmlns:xsd="http://www.w3.org/2001/XMLSchema"/>
    </wsdl:message>
    <wsdl:message name="CalculateLTVInputMessage">
        <wsdl:part name="CalculateLTVInput" element="types:CalculateLTVInput"/>
    </wsdl:message>
    <wsdl:message name="CalculateLTVOutputMessage">
        <wsdl:part name="CalculateLTVOutput" element="types:CalculateLTVOutput"/>
    </wsdl:message>

    <!-- PortType - Database Adapter Operations -->
    <wsdl:portType name="LoanDB_ptt">
        <wsdl:operation name="insertLoanApplication">
            <wsdl:documentation>
                Insert new loan application record.
                JCA: oracle.tip.adapter.db.DBWriteInteractionSpec
                DmlType: INSERT
                DescriptorName: LoanDB.LoanApplication
            </wsdl:documentation>
            <wsdl:input message="tns:LoanApplicationCollectionMessage"/>
        </wsdl:operation>

        <wsdl:operation name="updateLoanApplication">
            <wsdl:documentation>
                Update existing loan application record.
                JCA: oracle.tip.adapter.db.DBWriteInteractionSpec
                DmlType: UPDATE
                DescriptorName: LoanDB.LoanApplication
            </wsdl:documentation>
            <wsdl:input message="tns:LoanApplicationCollectionMessage"/>
        </wsdl:operation>

        <wsdl:operation name="selectLoanById">
            <wsdl:documentation>
                Select loan application by ID.
                JCA: oracle.tip.adapter.db.DBReadInteractionSpec
                QueryObjectName: selectLoanById
                DescriptorName: LoanDB.LoanApplication
            </wsdl:documentation>
            <wsdl:input message="tns:LoanSelectByIdMessage"/>
            <wsdl:output message="tns:LoanApplicationCollectionMessage"/>
        </wsdl:operation>

        <wsdl:operation name="calculateLTV">
            <wsdl:documentation>
                Calculate Loan-to-Value ratio.
                JCA: oracle.tip.adapter.db.DBStoredProcedureInteractionSpec
                Schema: LENDWISE
                Package: LOAN_PKG
                Procedure: CALCULATE_LTV
            </wsdl:documentation>
            <wsdl:input message="tns:CalculateLTVInputMessage"/>
            <wsdl:output message="tns:CalculateLTVOutputMessage"/>
        </wsdl:operation>
    </wsdl:portType>

    <!-- JCA Binding -->
    <wsdl:binding name="LoanDB_binding" type="tns:LoanDB_ptt">
        <jca:binding/>
        <wsdl:operation name="insertLoanApplication">
            <jca:operation/>
            <wsdl:input/>
        </wsdl:operation>
        <wsdl:operation name="updateLoanApplication">
            <jca:operation/>
            <wsdl:input/>
        </wsdl:operation>
        <wsdl:operation name="selectLoanById">
            <jca:operation/>
            <wsdl:input/>
            <wsdl:output/>
        </wsdl:operation>
        <wsdl:operation name="calculateLTV">
            <jca:operation/>
            <wsdl:input/>
            <wsdl:output/>
        </wsdl:operation>
    </wsdl:binding>

    <!-- Service -->
    <wsdl:service name="LoanDB_service">
        <wsdl:port name="LoanDB_pt" binding="tns:LoanDB_binding">
            <jca:address location="eis/DB/LendWiseDS"/>
        </wsdl:port>
    </wsdl:service>

    <!-- Partner Link Type -->
    <plnk:partnerLinkType name="LoanDB_plt">
        <plnk:role name="LoanDBProvider" portType="tns:LoanDB_ptt"/>
    </plnk:partnerLinkType>

</wsdl:definitions>
